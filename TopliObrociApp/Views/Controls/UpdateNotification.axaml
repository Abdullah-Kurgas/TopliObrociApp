<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TopliObrociApp.Views.Controls.UpdateNotification">
    <Border Background="{DynamicResource SystemChromeMediumColor}"
            BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
            Padding="16,12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="14">
            <TextBlock Grid.Column="0"
                       Text="ⓘ"
                       FontSize="22"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Spacing="3"
                        VerticalAlignment="Center">

                <TextBlock x:Name="UpdateTitle"
                           FontWeight="SemiBold" />

                <TextBlock x:Name="UpdateDescription"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="2"
                    Content="Zatvori aplikaciju"
                    VerticalAlignment="Center"
                    Click="CloseApplication_Click" />
        </Grid>
    </Border>
</UserControl>