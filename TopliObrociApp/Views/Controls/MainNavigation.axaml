<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    x:Class="TopliObrociApp.Views.Controls.MainNavigation">
    <UserControl.Styles>
        <Style Selector="RadioButton.navItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#71717A" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="CornerRadius" Value="50" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="9"
                                    VerticalAlignment="Center">

                            <avalonia:FluentIcon Icon="{TemplateBinding Tag}"
                                                 FontSize="20"
                                                 FontWeight="Medium"
                                                 VerticalAlignment="Center" />

                            <ContentPresenter Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center" />

                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.navItem:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
        </Style>

        <Style Selector="RadioButton.navItem:checked">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
        </Style>

        <Style Selector="RadioButton.navItem:checked /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        </Style>

        <Style Selector="Button.userButton">
            <Setter Property="Height" Value="50" />
            <Setter Property="MaxHeight" Value="50" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10 8 16 8" />
            <Setter Property="CornerRadius" Value="50" />
        </Style>

        <Style Selector="Button.dropdownItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />

        </Style>

        <Style Selector="Button.dropdownItem:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource SystemControlBackgroundAltMediumHighBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto,*"
          Margin="24,10,24,10">

        <Border Grid.Column="0"
                MaxHeight="50"
                Height="50"
                Background="{DynamicResource SystemChromeMediumColor}"
                BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
                CornerRadius="50"
                HorizontalAlignment="Left"
                Padding="14,0,18,0">

            <StackPanel Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">

                <Image Source="avares://TopliObrociApp/Assets/Windows/icon-48x48px.png"
                       Width="38"
                       Height="38"
                       Stretch="Uniform"
                       DoubleTapped="DoubleTapped" />

                <TextBlock Text="Topli obroci"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Navigation -->
        <Border Grid.Column="1"
                MaxHeight="50"
                Height="50"
                Background="{DynamicResource SystemChromeMediumColor}"
                BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
                CornerRadius="50"
                Padding="4">

            <StackPanel Orientation="Horizontal" Spacing="4">

                <RadioButton Classes="navItem"
                             Content="Mjesečni pregled"
                             Tag="BowlChopsticks"
                             GroupName="MainNav"
                             IsChecked="True"
                             Click="TopliObrok_Click" />

                <RadioButton Classes="navItem"
                             Content="Radni raspored"
                             Tag="Calendar"
                             GroupName="MainNav"
                             IsVisible="False"
                             Click="Radniraspored_Click" />

                <RadioButton x:Name="RadniciNav"
                             Classes="navItem"
                             Content="Radnici"
                             Tag="People"
                             GroupName="MainNav"
                             Click="Radnici_Click" />

            </StackPanel>
        </Border>

        <Button Grid.Column="2"
                Classes="userButton"
                Background="{DynamicResource SystemChromeMediumColor}"
                BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">

                <Border Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{DynamicResource SystemChromeLowColor}">

                    <TextBlock x:Name="UserInitial"
                               Text="?"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="2" VerticalAlignment="Center">

                    <TextBlock x:Name="UserFullName"
                               FontSize="13"
                               FontWeight="SemiBold" />

                    <TextBlock Text="Korisnički račun"
                               FontSize="11"
                               Foreground="#A1A1AA" />

                </StackPanel>
            </StackPanel>

            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Width="190" Margin="-7">
                        <Button Classes="dropdownItem"
                                HorizontalContentAlignment="Left"
                                Name="OdjavaBtn"
                                IsVisible="False"
                                Click="Logout_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <avalonia:FluentIcon Icon="SignOut" />

                                <TextBlock Text="Odjava" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

    </Grid>
</UserControl>