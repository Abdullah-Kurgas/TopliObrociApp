<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="using:FluentIcons.Avalonia"
        mc:Ignorable="d"
        x:Class="TopliObrociApp.Views.MainView">
    <Window.Styles>
        <Style Selector="RadioButton.navItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#71717A" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="CornerRadius" Value="50" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="9"
                                    VerticalAlignment="Center">

                            <ic:FluentIcon Icon="{TemplateBinding Tag}"
                                           FontSize="20"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />

                            <ContentPresenter Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center" />

                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.navItem:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
        </Style>

        <Style Selector="RadioButton.navItem:checked">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
        </Style>

        <Style Selector="RadioButton.navItem:checked /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        </Style>

        <Style Selector="Button.userButton">
            <Setter Property="Height" Value="50" />
            <Setter Property="MaxHeight" Value="50" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10 8 16 8" />
            <Setter Property="CornerRadius" Value="50" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,*"
              Margin="24,10,24,10">
            <Border Grid.Column="0"
                    MaxHeight="50"
                    Height="50"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
                    CornerRadius="50"
                    HorizontalAlignment="Left"
                    Padding="11 0 15 0">
                <StackPanel Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center">
                    <Image Source="avares://TopliObrociApp/Assets/Windows/icon-256x256px.png"
                           Width="38"
                           Height="38"
                           Stretch="Uniform" />

                    <TextBlock Text="Topli obroci"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    MaxHeight="50"
                    Height="50"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
                    CornerRadius="50"
                    Padding="4">

                <StackPanel Orientation="Horizontal"
                            Spacing="4">
                    <RadioButton Classes="navItem"
                                 Content="Topli obrok"
                                 Tag="BowlChopsticks"
                                 GroupName="MainNav"
                                 IsChecked="True"
                                 Click="TopliObrok_Click" />

                    <RadioButton Classes="navItem"
                                 Content="Radni raspored"
                                 Tag="Calendar"
                                 GroupName="MainNav"
                                 Click="Radniraspored_Click" />

                    <RadioButton Name="RadniciNav"
                                 Classes="navItem"
                                 Content="Radnici"
                                 Tag="People"
                                 GroupName="MainNav"
                                 Click="Radnici_Click" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Classes="userButton"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="{DynamicResource SystemChromeLowColor}">
                        <TextBlock Name="UserInitial"
                                   Text="?"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Name="UserFullName"
                                   FontSize="13"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Korisnički račun"
                                   FontSize="11"
                                   Foreground="#A1A1AA" />
                    </StackPanel>

                    <!-- <ic:FluentIcon Icon="ChevronDown" -->
                    <!--                FontSize="16" -->
                    <!--                Foreground="#A1A1AA" -->
                    <!--                Margin="4,0,2,0" /> -->
                </StackPanel>
            </Button>

        </Grid>

        <ContentControl x:Name="ContentArea" Grid.Row="1" Padding="24 0 24 24" />
    </Grid>
</Window>