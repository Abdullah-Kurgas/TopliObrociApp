<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="TopliObrociApp.Views.MainView">
    <UserControl.Styles>
        <Style Selector="RadioButton.navItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ic:FluentIcon Icon="{TemplateBinding Tag}" FontSize="20" VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.navItem:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
        </Style>
        <Style Selector="RadioButton.navItem:pointerover">
            <Setter Property="Foreground" Value="#E4E4E7" />
        </Style>

        <Style Selector="RadioButton.navItem:checked /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        </Style>
        <Style Selector="RadioButton.navItem:checked">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
        </Style>

        <Style Selector="Button.actionItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.actionItem:pointerover">
            <Setter Property="Foreground" Value="#E4E4E7" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0" HorizontalAlignment="Stretch" Padding="15">
            <Grid RowDefinitions="Auto, *, Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,32,0,32" Spacing="12"
                            HorizontalAlignment="Center">
                    <Image
                        Source="/Assets/Windows/TopliObroci.ico"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center" />
                    <TextBlock Text="Topli Obroci" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Classes="navItem" Content="Topli obrok" Tag="BowlChopsticks" IsChecked="True"
                                 GroupName="MainNav" Click="TopliObrok_Click" />
                    <RadioButton Classes="navItem" Content="Korisnici" Tag="People" GroupName="MainNav"
                                 Click="Korisnici_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Classes="actionItem" Content="Postavke" />
                    <Button Classes="actionItem" Content="Odjava" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="ContentArea" Grid.Column="1" />
    </Grid>
</UserControl>