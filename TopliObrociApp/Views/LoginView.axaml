<UserControl
    x:Class="TopliObrociApp.Views.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Width="500"
        Height="430"
        Background="{DynamicResource SystemChromeMediumColor}"
        BorderBrush="{DynamicResource SystemChromeDisabledHighColor}"
        BorderThickness="1"
        CornerRadius="16"
        BoxShadow="0 8 30 0 #20000000"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <Grid
            Margin="75,40"
            RowDefinitions="*,Auto">
            <StackPanel
                Grid.Row="0"
                VerticalAlignment="Center">
                <Border
                    x:Name="SelectedUserAvatar"
                    Width="95"
                    Height="95"
                    CornerRadius="25"
                    Background="{DynamicResource SystemChromeLowColor}"
                    HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="SelectedUserInitial"
                        Text="?"
                        FontSize="35"
                        FontWeight="SemiBold"
                        Opacity=".5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <TextBlock
                    x:Name="SelectedUserName"
                    Text="Izaberite korisnika"
                    FontSize="22"
                    FontWeight="Medium"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0" />

                <AutoCompleteBox
                    x:Name="ReprezentAutoComplete"
                    PlaceholderText="Unesi svoje ime..."
                    FilterMode="None"
                    TextChanged="ReprezentAutoComplete_OnTextChanged"
                    Height="44"
                    FontSize="14"
                    Margin="0 50 0 0"
                    Padding="12"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" />

                <TextBox
                    x:Name="PasswordBox"
                    PasswordChar="●"
                    PlaceholderText="Unesite šifru"
                    Height="44"
                    FontSize="14"
                    Padding="12"
                    CornerRadius="10"
                    IsVisible="False"
                    BorderBrush="{DynamicResource SystemChromeDisabledHighColor}" />

                <Button
                    x:Name="LoginButton"
                    Content="Nastavi"
                    Height="44"
                    CornerRadius="8"
                    Padding="15 10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="25,50,25,0"
                    IsVisible="False"
                    Click="LoginButton_Click" />

                <TextBlock
                    x:Name="ErrorText"
                    Text=""
                    Foreground="#DC2626"
                    FontSize="14"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Border>
</UserControl>